-        }
+    for (const [key, prev] of endPrev) {
+      const curr = begCurr.get(key);
+      const sfPrev = prev.saldo;
+      const siCurr = curr ? curr.saldo : 0;
+      if (Math.abs(siCurr - sfPrev) > 0.01) {
