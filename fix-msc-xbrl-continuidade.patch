-      if (cAcc) {
-        const sfPrev = pAcc.Natureza_valor === 'C' ? -pAcc.Valor : pAcc.Valor;
-        const siCurr = cAcc.Natureza_valor === 'C' ? -cAcc.Valor : cAcc.Valor;
-        if (Math.abs(siCurr - sfPrev) > 0.01) {
-          hasDiff = true;
